<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>XivRug</AssemblyName>
    <Version>0.0.1.13</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TerraFX.Interop.Windows">
      <HintPath>$(DalamudLibPath)TerraFX.Interop.Windows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="../XivSurface.Core/XivSurface.Core.csproj" />
    <ProjectReference Include="../XivCloth.Core/XivCloth.Core.csproj" />
    <ProjectReference Include="../XivSurface.RenderedGeometry/XivSurface.RenderedGeometry.csproj" />
    <ProjectReference Include="../XivSurface.Dalamud/XivSurface.Dalamud.csproj" />
    <Compile Include="../../adapters/PhysicalClothPresentation.cs" Link="Rendering/PhysicalClothPresentation.cs" />
    <Compile Include="../../adapters/ClothRenderPublication.cs" Link="Rendering/ClothRenderPublication.cs" />
  </ItemGroup>
</Project>
