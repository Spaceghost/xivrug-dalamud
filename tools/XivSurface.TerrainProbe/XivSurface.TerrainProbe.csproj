<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><IsPackable>false</IsPackable>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(MSBuildThisFileDirectory)../../.dalamud/</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/XivSurface.RenderedGeometry/XivSurface.RenderedGeometry.csproj" />
    <Reference Include="Lumina"><HintPath>$([System.IO.Path]::Combine('$(DalamudLibPath)', 'Lumina.dll'))</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
