    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <ProjectReference Include="../../src/XivSurface.RenderedGeometry/XivSurface.RenderedGeometry.csproj" />
    <Compile Include="../../src/XivRug.Plugin/TerrainArchiveReadPolicy.cs" Link="TerrainArchiveReadPolicy.cs" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
